{
    "name": "oxlint-config-jwalker",
    "version": "0.2.1",
    "description": "Shareable framework-agnostic oxlint config",
    "author": "Jonatas Walker",
    "homepage": "https://github.com/jonataswalker/oxlint-config-jwalker",
    "type": "module",
    "engines": {
        "node": "^22.20 || ^24 || ^26"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": "./config/index.js"
    },
    "types": "./config/index.d.ts",
    "files": [
        "config"
    ],
    "keywords": [
        "oxlint",
        "oxlint-config",
        "oxc"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jonataswalker/oxlint-config-jwalker.git"
    },
    "bugs": {
        "url": "https://github.com/jonataswalker/oxlint-config-jwalker/issues"
    },
    "license": "MIT",
    "scripts": {
        "lint": "oxlint --type-aware",
        "lint:fix": "npm run lint -- --fix",
        "gen:types": "rm -f config/*.d.ts && tsc -p tsconfig.build.json",
        "test": "node --test test/*.spec.js",
        "release": "release-it --no-npm.publish",
        "check:declarations": "npm run gen:types && node scripts/check-declarations.mjs",
        "check:package": "publint && node scripts/check-package.mjs",
        "verify": "npm run lint && npm test && npm run check:declarations && npm run check:package"
    },
    "peerDependencies": {
        "oxlint": ">=1.77.0",
        "oxlint-tsgolint": ">=7.0.2001",
        "tsrs": ">=7.1.0-beta.tsrs2"
    },
    "peerDependenciesMeta": {
        "oxlint-tsgolint": {
            "optional": true
        },
        "tsrs": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "publint": "0.3.25",
        "release-it": "21.1.2",
        "typescript": "7.0.2"
    },
    "overrides": {
        "basic-ftp": "^6.2.6"
    },
    "release-it": {
        "github": {
            "release": true
        }
    }
}
